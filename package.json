{
  "name": "cashback-at-cloudflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --env-interface Env worker-configuration.d.ts",
    "verify:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ./verify-production.ps1",
    "db:create": "wrangler d1 create cashback-db",
    "db:init:local": "wrangler d1 execute cashback-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cashback-db --remote --file=./schema.sql",
    "db:migrate:commercial": "wrangler d1 execute cashback-db --remote --file=./migrations/012_commercial_readiness.sql",
    "db:migrate:email-verification": "wrangler d1 execute cashback-db --remote --file=./migrations/013_email_verification.sql",
    "db:migrate:savings-goals": "wrangler d1 execute cashback-db --remote --file=./migrations/014_savings_goals.sql",
    "db:accounts:local": "wrangler d1 execute cashback-db --local --file=./migrations/002_accounts.sql",
    "db:accounts:remote": "wrangler d1 execute cashback-db --remote --file=./migrations/002_accounts.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.123.0"
  }
}
